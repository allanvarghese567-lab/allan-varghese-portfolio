# --- Admin login (required for /admin) ---
NEXT_PUBLIC_ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Publish via SERVER SECRET (recommended on Vercel / Node) ---
# Fine-grained PAT with Contents: Read and write on this repo.
# Name must match exactly. Do NOT use NEXT_PUBLIC_ for the token.
PORTFOLIO_GITHUB_TOKEN=github_pat_xxxxxxxx

# Optional overrides (defaults match this project)
PORTFOLIO_GITHUB_OWNER=allanvarghese567-lab
PORTFOLIO_GITHUB_REPO=allan-varghese-portfolio

# --- Optional public defaults for admin form (not the token) ---
NEXT_PUBLIC_GITHUB_OWNER=allanvarghese567-lab
NEXT_PUBLIC_GITHUB_REPO=allan-varghese-portfolio
