# --- Admin login (required) ---
# Set the same name as a GitHub Actions *secret* if you build on GitHub,
# or as an env var on Vercel. Value is embedded in the client build.
NEXT_PUBLIC_ADMIN_PASSWORD=change-me-to-a-strong-password

# --- GitHub publish credentials (optional defaults for admin form) ---
# Owner + repo can be public variables / env. TOKEN must NEVER be NEXT_PUBLIC.
NEXT_PUBLIC_GITHUB_OWNER=allanvarghese567-lab
NEXT_PUBLIC_GITHUB_REPO=allan-varghese-portfolio
# TOKEN: paste only in /admin → GitHub credentials (browser localStorage)
